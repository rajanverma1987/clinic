{
  "name": "clinic-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Clinic SaaS monorepo: website (doctorsclinic.services) + clinic app (account.doctorsclinic.services)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@clinic-saas/clinic",
    "dev:clinic": "npm run dev --workspace=@clinic-saas/clinic",
    "dev:website": "npm run dev --workspace=@clinic-saas/website",
    "setup": "npm run setup --workspace=@clinic-saas/clinic",
    "build": "npm run build --workspace=@clinic-saas/clinic",
    "build:clinic": "npm run build --workspace=@clinic-saas/clinic",
    "build:website": "npm run build --workspace=@clinic-saas/website",
    "start": "npm run start --workspace=@clinic-saas/clinic",
    "start:clinic": "npm run start --workspace=@clinic-saas/clinic",
    "start:website": "npm run start --workspace=@clinic-saas/website"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "glob": "^11.0.0",
    "fast-xml-parser": "^5.3.6"
  }
}