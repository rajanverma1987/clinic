# Public marketing website – no dashboard, no auth, no clinic data.
# Deploy to www.yoursite.com

# Clinic dashboard URL. Login → {CLINIC_APP_URL}/login. Get Clinic Access → {CLINIC_APP_URL}.
# If unset: development uses http://localhost:5053, production uses https://accounts.doctorsclinic.services
# NEXT_PUBLIC_CLINIC_APP_URL=http://localhost:5053
# NEXT_PUBLIC_CLINIC_APP_URL=https://accounts.doctorsclinic.services

# Clinic app API URL. Website app fetches pricing/subscription data from clinic app API.
# If unset: development uses http://localhost:5053/api, production uses {NEXT_PUBLIC_CLINIC_APP_URL}/api
# NEXT_PUBLIC_API_URL=http://localhost:5053/api
# NEXT_PUBLIC_API_URL=https://accounts.doctorsclinic.services/api
