# =============================================================================
# .dockerignore - Files to exclude from Docker build context
# =============================================================================
# This reduces build time and image size by excluding unnecessary files
# =============================================================================

# Dependencies (will be installed during build)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build outputs
.next
out
build
dist

# Testing
coverage
.nyc_output
*.test.js
*.spec.js
__tests__
__mocks__

# Environment files (use docker-compose environment instead)
.env
.env.local
.env.development
.env.test
.env*.local

# Git
.git
.gitignore
.gitattributes

# IDE
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Documentation
*.md
!README.md
docs
CursorMD

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Misc
.cache
.parcel-cache
.eslintcache
.stylelintcache
.prettierignore

# Temporary files
tmp
temp
*.tmp

# OS
Thumbs.db
.DS_Store

# Database
*.sqlite
*.db

# Backups
*.backup
*.bak
backups/

# Scripts (not needed in production)
scripts/seed-*.js
scripts/test-*.js
scripts/check-*.js
