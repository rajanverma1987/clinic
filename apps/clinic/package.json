{
  "name": "@clinic-saas/clinic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "git": "git add . && git commit -m 'update' && git push",
    "dev": "node  server.js",
    "dev:clean": "rm -rf .next && node  server.js",
    "dev:next": "next dev -p 5053",
    "build": "node -r ./lib/run-self-polyfill.cjs ../../node_modules/next/dist/bin/next build",
    "start": "cross-env NODE_ENV=production node server.js",
    "start:next": "next start -p 5053",
    "setup": "node -r dotenv/config scripts/setup.js dotenv_config_path=.env.local",
    "admin:list": "node -r dotenv/config scripts/manage-admin.js list dotenv_config_path=.env.local",
    "admin:create": "node -r dotenv/config scripts/manage-admin.js create dotenv_config_path=.env.local",
    "admin:reset": "node -r dotenv/config scripts/manage-admin.js reset dotenv_config_path=.env.local",
    "admin:verify": "node -r dotenv/config scripts/manage-admin.js verify dotenv_config_path=.env.local",
    "admin:health": "node -r dotenv/config scripts/manage-admin.js health dotenv_config_path=.env.local",
    "admin:ensure-test": "node -r dotenv/config scripts/manage-admin.js ensure-test-super-admin dotenv_config_path=.env.local",
    "admin:quick": "node -r dotenv/config scripts/create-default-admin.js dotenv_config_path=.env.local",
    "seed:plans": "node -r dotenv/config scripts/seed-subscription-plans.js dotenv_config_path=.env.local",
    "seed:patients": "node -r dotenv/config scripts/seed-patients.js dotenv_config_path=.env.local",
    "setup:paypal-plans": "node -r dotenv/config scripts/setup-paypal-plans.js dotenv_config_path=.env.local",
    "cleanup:users:dry-run": "node -r dotenv/config scripts/cleanup-duplicate-users.js --dry-run dotenv_config_path=.env.local",
    "cleanup:users:execute": "node -r dotenv/config scripts/cleanup-duplicate-users.js --execute dotenv_config_path=.env.local",
    "reset:password": "node -r dotenv/config scripts/reset-admin-password.js dotenv_config_path=.env.local",
    "reactivate:user": "node -r dotenv/config scripts/reactivate-user.js dotenv_config_path=.env.local",
    "seed:db": "node -r dotenv/config scripts/seed-database.js dotenv_config_path=.env.local",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "backup:db": "node -r dotenv/config scripts/backup-database.js dotenv_config_path=.env.local",
    "backup:restore": "node -r dotenv/config scripts/restore-database.js dotenv_config_path=.env.local",
    "backup:stats": "node -r dotenv/config scripts/backup-stats.js dotenv_config_path=.env.local",
    "check:buttons": "node scripts/check-button-consistency.js",
    "check:buttons:enterprise": "node scripts/check-button-consistency-enterprise.js",
    "check:buttons:json": "node scripts/check-button-consistency-enterprise.js --json",
    "check:buttons:html": "node scripts/check-button-consistency-enterprise.js --html",
    "check:buttons:ci": "CI=true node scripts/check-button-consistency-enterprise.js --json",
    "generate:dashboard-json": "node scripts/generate-dashboard-structure-json.js",
    "fix:encryption": "node -r dotenv/config scripts/fix-encryption-warnings.js dotenv_config_path=.env.local",
    "update-dashboard-metrics": "node -r dotenv/config scripts/update-dashboard-metrics.js dotenv_config_path=.env.local",
    "dashboard-indexes": "node -r dotenv/config scripts/create-dashboard-indexes.js dotenv_config_path=.env.local",
    "inventory:fill-translations": "node scripts/fill-inventory-item-translations.js"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.992.0",
    "@clinic-saas/config": "*",
    "@clinic-saas/dashboard-engine": "0.0.1",
    "@elastic/elasticsearch": "^9.2.0",
    "@tanstack/react-virtual": "^3.13.18",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.26",
    "html2canvas": "^1.4.1",
    "immer": "^10.0.3",
    "joi": "^17.13.0",
    "jsbarcode": "^3.12.3",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.1.0",
    "lucide-react": "^0.556.0",
    "mongoose": "^8.3.0",
    "next": "^15.5.10",
    "nodemailer": "^7.0.11",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "redis": "^4.6.0",
    "simple-peer": "^9.11.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "speakeasy": "^2.0.0",
    "swr": "^2.2.5",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.23.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "autoprefixer": "^10.4.0",
    "babel-jest": "^30.2.0",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0"
  }
}
