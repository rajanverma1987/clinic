# =============================================================================
# CLINIC SAAS - PRODUCTION Environment Configuration
# =============================================================================
#
# IMPORTANT: This is a TEMPLATE file. DO NOT commit actual production values!
#
# Setup Instructions:
# 1. Copy this file: cp .env.production.template .env.production
# 2. Fill in all values marked with <REPLACE_WITH_...>
# 3. NEVER commit .env.production to version control
# 4. Use a secrets management service (AWS Secrets Manager, Vault, etc.)
# =============================================================================

# -----------------------------------------------------------------------------
# CRITICAL SECURITY - REQUIRED
# -----------------------------------------------------------------------------

# Database - MongoDB Production Connection
# ⚠️ Use production database with SSL/TLS enabled
# ⚠️ Use strong credentials, store in secrets manager
MONGODB_URI=<REPLACE_WITH_PRODUCTION_MONGODB_URI>
# Example: mongodb+srv://produser:STRONG_PASSWORD@cluster.mongodb.net/clinic_prod?retryWrites=true&w=majority&ssl=true

# Pool settings for production
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# Authentication - JWT Secrets
# ⚠️ CRITICAL: Generate new secrets for production (DO NOT reuse development keys)
# Generate: openssl rand -hex 32
JWT_SECRET=<REPLACE_WITH_256_BIT_SECRET>
JWT_REFRESH_SECRET=<REPLACE_WITH_256_BIT_SECRET>
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# Encryption - PHI Data Protection
# ⚠️ CRITICAL: Generate new key for production (DO NOT reuse development key)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=<REPLACE_WITH_256_BIT_KEY>

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION - REQUIRED
# -----------------------------------------------------------------------------

# Environment
NODE_ENV=production

# Server Configuration
PORT=5053
HOSTNAME=0.0.0.0

# Application URLs
# ⚠️ Update with your production domain (HTTPS only!)
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api
NEXT_PUBLIC_SOCKET_URL=https://your-domain.com

# CORS Origins (comma-separated)
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# -----------------------------------------------------------------------------
# SECURITY SETTINGS - REQUIRED
# -----------------------------------------------------------------------------

# Disable test account in production
TEST_ACCOUNT_ENABLED=false

# IP Whitelist for Admin Routes (comma-separated)
# Example: 203.0.113.10,203.0.113.20
ADMIN_IP_WHITELIST=<REPLACE_WITH_ADMIN_IPS>

# Rate Limiting (uses Redis if available, otherwise in-memory)
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# REDIS - HIGHLY RECOMMENDED FOR PRODUCTION
# -----------------------------------------------------------------------------
# Used for: Caching, Rate Limiting, Session Management
# Without Redis: Single-instance only, slower performance

REDIS_URL=<REPLACE_WITH_REDIS_URL>
# Example: redis://default:PASSWORD@redis.your-domain.com:6379
# Or AWS ElastiCache: redis://master.your-cluster.cache.amazonaws.com:6379

# Optional: Disable Redis if not available (not recommended for production)
# DISABLE_REDIS=false

# -----------------------------------------------------------------------------
# EMAIL / SMTP - REQUIRED FOR PASSWORD RESET
# -----------------------------------------------------------------------------

SMTP_HOST=<REPLACE_WITH_SMTP_HOST>
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<REPLACE_WITH_SMTP_USER>
SMTP_PASSWORD=<REPLACE_WITH_SMTP_PASSWORD>
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=Doctor's Clinic

# -----------------------------------------------------------------------------
# PAYMENT PROCESSORS - REQUIRED FOR SUBSCRIPTIONS (PayPal only)
# -----------------------------------------------------------------------------

# PayPal (Production)
PAYPAL_CLIENT_ID=<REPLACE_WITH_PAYPAL_CLIENT_ID>
PAYPAL_CLIENT_SECRET=<REPLACE_WITH_PAYPAL_SECRET>
PAYPAL_BASE_URL=https://api-m.paypal.com
PAYPAL_WEBHOOK_ID=<REPLACE_WITH_PAYPAL_WEBHOOK_ID>

# -----------------------------------------------------------------------------
# TELEMEDICINE - REQUIRED FOR VIDEO CALLS
# -----------------------------------------------------------------------------

# TURN Server (for NAT traversal)
# ⚠️ WebRTC won't work reliably without TURN server
NEXT_PUBLIC_TURN_SERVER_URL=turn:turn.your-domain.com:3478
NEXT_PUBLIC_TURN_USERNAME=<REPLACE_WITH_TURN_USERNAME>
NEXT_PUBLIC_TURN_CREDENTIAL=<REPLACE_WITH_TURN_PASSWORD>

# STUN Server (optional, Google's public STUN as fallback)
NEXT_PUBLIC_STUN_SERVER_URL=stun:stun.l.google.com:19302

# -----------------------------------------------------------------------------
# SMS / WHATSAPP - OPTIONAL FOR REMINDERS
# -----------------------------------------------------------------------------

# Twilio
TWILIO_ACCOUNT_SID=<REPLACE_WITH_TWILIO_SID>
TWILIO_AUTH_TOKEN=<REPLACE_WITH_TWILIO_TOKEN>
TWILIO_PHONE_NUMBER=<REPLACE_WITH_TWILIO_PHONE>

# WhatsApp Business API
WHATSAPP_BUSINESS_ACCOUNT_ID=<REPLACE_WITH_WHATSAPP_ACCOUNT_ID>
WHATSAPP_ACCESS_TOKEN=<REPLACE_WITH_WHATSAPP_TOKEN>
WHATSAPP_PHONE_NUMBER_ID=<REPLACE_WITH_WHATSAPP_PHONE_ID>
WHATSAPP_WEBHOOK_VERIFY_TOKEN=<REPLACE_WITH_WEBHOOK_TOKEN>

# -----------------------------------------------------------------------------
# FILE STORAGE - OPTIONAL (AWS S3)
# -----------------------------------------------------------------------------

# AWS S3 for file uploads (prescriptions, patient documents)
AWS_ACCESS_KEY_ID=<REPLACE_WITH_AWS_KEY>
AWS_SECRET_ACCESS_KEY=<REPLACE_WITH_AWS_SECRET>
AWS_REGION=us-east-1
AWS_S3_BUCKET=clinic-files-production
AWS_S3_ENDPOINT=<OPTIONAL_CUSTOM_ENDPOINT>

# Alternative: Local file storage path
# FILE_UPLOAD_PATH=/var/clinic/uploads

# -----------------------------------------------------------------------------
# CDN - OPTIONAL FOR PERFORMANCE
# -----------------------------------------------------------------------------

# CloudFront or other CDN URL
CDN_URL=https://cdn.your-domain.com

# -----------------------------------------------------------------------------
# MONITORING & LOGGING - RECOMMENDED
# -----------------------------------------------------------------------------

# Sentry for Error Tracking
SENTRY_DSN=<REPLACE_WITH_SENTRY_DSN>
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Log Level (error, warn, info, debug)
LOG_LEVEL=warn

# CloudWatch Logs (AWS)
CLOUDWATCH_LOG_GROUP=/aws/clinic/production
CLOUDWATCH_LOG_STREAM=app-logs

# -----------------------------------------------------------------------------
# SEARCH - OPTIONAL (Elasticsearch)
# -----------------------------------------------------------------------------

ELASTICSEARCH_NODE=https://search.your-domain.com:9200
ELASTICSEARCH_USERNAME=<REPLACE_WITH_ES_USER>
ELASTICSEARCH_PASSWORD=<REPLACE_WITH_ES_PASSWORD>

# -----------------------------------------------------------------------------
# SECURITY HARDENING - OPTIONAL
# -----------------------------------------------------------------------------

# Session timeout (in minutes)
SESSION_TIMEOUT=120

# Maximum login attempts before lockout
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=30m

# Force HTTPS
FORCE_HTTPS=true

# Helmet.js Security Headers (automatically applied)
# CSP is configured in next.config.js

# -----------------------------------------------------------------------------
# BACKUP & DISASTER RECOVERY - RECOMMENDED
# -----------------------------------------------------------------------------

# Automated backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=clinic-backups-production

# -----------------------------------------------------------------------------
# PERFORMANCE TUNING - OPTIONAL
# -----------------------------------------------------------------------------

# Node.js memory limit
NODE_OPTIONS=--max-old-space-size=4096

# Next.js build optimization
NEXT_TELEMETRY_DISABLED=1

# API timeout (milliseconds)
API_TIMEOUT=30000

# Database query timeout (milliseconds)
DB_QUERY_TIMEOUT=10000

# -----------------------------------------------------------------------------
# FEATURE FLAGS - OPTIONAL
# -----------------------------------------------------------------------------

# Enable/disable features without code changes
FEATURE_TELEMEDICINE=true
FEATURE_INVENTORY=true
FEATURE_LAB_TESTS=true
FEATURE_INSURANCE=true
FEATURE_WHATSAPP=true
FEATURE_SMS_REMINDERS=true

# -----------------------------------------------------------------------------
# COMPLIANCE - OPTIONAL
# -----------------------------------------------------------------------------

# HIPAA Compliance Mode
HIPAA_COMPLIANCE_MODE=true

# GDPR Compliance
GDPR_ENABLED=true

# Audit logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555

# -----------------------------------------------------------------------------
# END OF CONFIGURATION
# -----------------------------------------------------------------------------

# =============================================================================
# DEPLOYMENT CHECKLIST
# =============================================================================
#
# Before deploying to production:
#
# ✅ All <REPLACE_WITH_...> values filled in
# ✅ Secrets stored in secrets manager (not in .env file)
# ✅ Database has SSL/TLS enabled
# ✅ Redis configured and accessible
# ✅ SMTP server tested
# ✅ Payment webhooks registered
# ✅ TURN server configured and tested
# ✅ Monitoring/logging configured
# ✅ Backups configured
# ✅ SSL certificates installed
# ✅ DNS records configured
# ✅ Firewall rules configured
# ✅ Load balancer configured (if applicable)
# ✅ Health checks passing
# ✅ Smoke tests completed
#
# =============================================================================
