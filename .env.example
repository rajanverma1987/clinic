# =============================================================================
# Copy to .env.local and fill in your values. Same keys as .env.local.
# server.js loads .env then .env.local on npm run dev / npm start.
# =============================================================================

# Database – MongoDB connection (replace <password> with your real password in .env.local)
MONGODB_URI=mongodb://remoteUser:<password>@sql.infodatixhosting.com:27017/clinic?authSource=admin

# Authentication (generate with: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# Optional: test account is disabled. To re-enable for dev only: TEST_ACCOUNT_ENABLED=true (see lib/constants/test-account.js).
# TEST_ACCOUNT_EMAIL=706359@gmail.com
# TEST_ACCOUNT_ENABLED=true

# Test super admin (company account): 706359@gmail.com / Rtv@@123# — ensure with: npm run admin:ensure-test

# Encryption (PHI – generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-minimum-32-characters

# Application
NODE_ENV=development
PORT=5053
HOSTNAME=localhost
NEXT_PUBLIC_API_URL=http://localhost:5053/api
# Required for production: set to your public app URL (e.g. https://app.yourclinic.com)
NEXT_PUBLIC_APP_URL=http://localhost:5053
NEXT_PUBLIC_SOCKET_URL=http://localhost:5053/socket.io/
# Optional: external accounts URL and unique account ID for website Login/Register
# Login → accounts.doctorsclinic.services/{accountId}, Register → ...?role=doctor
# NEXT_PUBLIC_ACCOUNTS_URL=https://accounts.doctorsclinic.services
# NEXT_PUBLIC_ACCOUNTS_ACCOUNT_ID=doctorsclinic
# Production CORS: comma-separated allowed origins (or leave unset to use NEXT_PUBLIC_APP_URL)
# CORS_ORIGINS=https://app.yourclinic.com,https://admin.yourclinic.com

# Redis (optional – cache is skipped when Redis is unavailable)
# In development, Redis is not used if REDIS_URL is unset (no connection attempt, no warning).
# To use Redis locally: set REDIS_URL=redis://localhost:6379 and start Redis.
# To silence "Redis not available" when Redis is running but you don't want cache: DISABLE_REDIS=true
# REDIS_URL=redis://localhost:6379
# DISABLE_REDIS=true

# MongoDB connection pool (optional)
# MONGODB_MAX_POOL_SIZE=20
# MONGODB_MIN_POOL_SIZE=5

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Stripe (card payments for subscriptions and invoices)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# SMTP Email
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Doctor's Clinic
SMTP_REJECT_UNAUTHORIZED=true

# WebRTC TURN (telemedicine)
NEXT_PUBLIC_TURN_SERVER_URL=turn:host:3478
NEXT_PUBLIC_TURN_USERNAME=telemedicine
NEXT_PUBLIC_TURN_CREDENTIAL=your-turn-password
